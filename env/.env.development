# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV=development
VITE_MODE=development

# 构建配置
VITE_DELETE_CONSOLE=false
VITE_SHOW_SOURCEMAP=true

# 服务地址
VITE_SERVER_BASEURL=https://test-app.libertycats.app/api
VITE_IMAGE_HOST=https://test-app.libertycats.app/

# DApp 地址，结尾没有 /
VITE_DAPP_BASEURL=https://test-okx.libertycats.app
VITE_OKX_BASEURL=https://test-okx.libertycats.app

# WebSocket 配置
VITE_WS_HOST=test-app.libertycats.app
VITE_WS_APP_KEY=test-libertycats-key
