# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'production'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = true
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false
VITE_MODE  = 'production'

# H5 build 直连生产环境接口，不走代理
VITE_APP_PROXY = false
VITE_SERVER_BASEURL = 'https://app.libertycats.app/api'
VITE_IMAGE_HOST = 'https://app.libertycats.app/'
